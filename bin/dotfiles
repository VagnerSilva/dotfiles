# :command.usage
dotfiles_usage() {
  if [[ -n $long_usage ]]; then
    printf "dotfiles\n\n"
    printf "  Gerencia a instalação e reversão do ambiente Zsh deste repositório.\n  \n  Uso:\n    dotfiles install     instala zsh, ferramentas, Zinit e Nerd Font\n    dotfiles uninstall   remove apenas recursos criados por este projeto\n    dotfiles check       verifica pré-requisitos e estado, sem alterar nada\n    dotfiles help        mostra a ajuda de um comando\n\n"
  else
    printf "dotfiles - Gerencia a instalação e reversão do ambiente Zsh deste repositório.\n\n"
  fi

  printf "%s\n" "Usage:"
  printf "  dotfiles [OPTIONS] COMMAND\n"
  printf "  dotfiles [COMMAND] --help | -h\n"
  printf "  dotfiles --version\n"
  echo
  # :command.usage_commands
  printf "%s\n" "Commands:"
  printf "  %s   Instala Zsh, ferramentas, Zinit e Nerd Font com passos guiados.\n" "install  "
  printf "  %s   Remove apenas os recursos criados por este projeto.\n" "uninstall"
  printf "  %s   Verifica pré-requisitos e estado da instalação sem alterar nada.\n" "check    "
  printf "  %s   Mostra a ajuda de um comando.\n" "help     "
  echo

  # :command.long_usage
  if [[ -n "$long_usage" ]]; then
    # :command.usage_options
    printf "%s\n" "Global Options:"

    # :command.usage_flags
    # :flag.usage
    printf "  %s\n" "--verbose, -v"
    printf "    Exibe logs detalhados de cada etapa.\n"
    echo

    # :command.usage_fixed_flags
    printf "  %s\n" "--help, -h"
    printf "    Show this help\n"
    echo
    printf "  %s\n" "--version"
    printf "    Show version number\n"
    echo

  fi
}

